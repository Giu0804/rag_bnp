import torch
import pandas as pd
from transformers import AutoTokenizer, AutoModelForCausalLM

# ==========================================
# 1. CONFIGURATION ET PARAMÈTRES MÉCANISTES
# ==========================================

# ⚠️ L'Attributional Ensemble : 
# Selon le papier, seules quelques têtes d'attention spécifiques gèrent la citation.
# Tu devras remplacer cette liste par les coordonnées exactes (Couche, Tête) 
# identifiées pour Llama-3.1-8B (souvent dans les couches moyennes/tardives).
ATTRIBUTION_ENSEMBLE = [
    (15, 4), (18, 12), (20, 5), (22, 14) # Exemples fictifs à adapter
]

# ==========================================
# 2. FORMATAGE DU PROMPT (Personnalisable)
# ==========================================

def format_prompt_fn(question, paragraphs_list):
    """
    Construit le prompt en anglais avec la nomenclature 'Paragraph ID'.
    Retourne le system prompt et le user prompt séparément.
    """
    system_prompt = "You are an expert assistant. Answer the user's question based strictly on the provided paragraphs."
    
    context_parts = []
    for p in paragraphs_list:
        context_parts.append(f"[Paragraph ID: {p['id']}]\n{p['text']}")
        
    assembled_context = "\n\n".join(context_parts)
    user_prompt = f"Here are the documents:\n{assembled_context}\n\nQuestion: {question}"
    
    return system_prompt, user_prompt

def get_paragraph_token_spans(prompt_input_ids, paragraphs_list, tokenizer):
    """
    Identifie les indices de début et de fin de chaque paragraphe dans le prompt tokenisé.
    """
    token_spans = {}
    current_search_idx = 0
    prompt_list = prompt_input_ids.tolist()
    
    for p in paragraphs_list:
        marker_str = f"[Paragraph ID: {p['id']}]"
        marker_ids = tokenizer(marker_str, add_special_tokens=False).input_ids
        
        start_idx = None
        L = len(marker_ids)
        for i in range(current_search_idx, len(prompt_list) - L + 1):
            if prompt_list[i:i+L] == marker_ids:
                start_idx = i
                break
                
        if start_idx is not None:
            text_ids = tokenizer(p['text'], add_special_tokens=False).input_ids
            end_idx = start_idx + len(marker_ids) + len(text_ids)
            token_spans[p['id']] = (start_idx, min(end_idx, len(prompt_list)))
            current_search_idx = end_idx
            
    return token_spans

# ==========================================
# 3. GÉNÉRATION ET EXTRACTION DE L'ATTENTION
# ==========================================

def generate_with_attention(model, tokenizer, system_prompt, user_prompt):
    """
    Génère la réponse en forçant le modèle à renvoyer sa matrice d'attention.
    """
    messages = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": user_prompt}
    ]
    
    full_prompt = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
    inputs = tokenizer(full_prompt, return_tensors="pt").to(model.device)
    prompt_length = inputs.input_ids.shape[1]
    
    with torch.no_grad():
        outputs = model.generate(
            **inputs, 
            max_new_tokens=256, 
            do_sample=False,
            output_attentions=True,          # Indispensable pour la théorie
            return_dict_in_generate=True     # Indispensable pour récupérer l'objet proprement
        )
        
    generated_ids = outputs.sequences[0][prompt_length:]
    generated_text = tokenizer.decode(generated_ids, skip_special_tokens=True).strip()
    
    return generated_text, outputs.attentions, inputs.input_ids[0], generated_ids

# ==========================================
# 4. MOTEUR MATHÉMATIQUE (L'Application du Papier)
# ==========================================

def compute_attention_mapping_mechanistic(token_attentions, generated_ids, token_spans, tokenizer):
    """
    Calcule le score de chaque paragraphe en sommant UNIQUEMENT l'attention 
    des têtes définies dans l'Attributional Ensemble.
    """
    token_mapping = []
    
    # token_attentions contient un tuple par token généré
    for step_idx, step_attns in enumerate(token_attentions):
        token_id = generated_ids[step_idx].item()
        token_str = tokenizer.decode([token_id])
        
        # Initialisation des scores pour ce token
        paragraph_scores = {pid: 0.0 for pid in token_spans.keys()}
        
        # Application stricte de la théorie : on ne lit QUE les têtes causales
        for (layer_idx, head_idx) in ATTRIBUTION_ENSEMBLE:
            # step_attns[layer_idx] shape : (batch=1, num_heads, seq_len_step=1, total_prompt_len)
            layer_attn = step_attns[layer_idx]
            
            # On isole le vecteur d'attention de la tête spécifique
            specific_head_attn = layer_attn[0, head_idx, 0, :] 
            
            # Sommation de l'attention sur la plage de tokens de chaque paragraphe
            for pid, (start, end) in token_spans.items():
                if start < len(specific_head_attn):
                    score = specific_head_attn[start:min(end, len(specific_head_attn))].sum().item()
                    paragraph_scores[pid] += score
                    
        # Le paragraphe ayant reçu le plus d'attention de cet ensemble gagne
        best_pid = max(paragraph_scores, key=paragraph_scores.get) if paragraph_scores else None
        
        token_mapping.append({
            "token": token_str,
            "best_pid": best_pid
        })
        
    return token_mapping

def build_cited_answer(token_mapping):
    """
    Regroupe les tokens successifs pointant vers le même paragraphe (Span Merging)
    et injecte la balise [ID].
    """
    if not token_mapping: return ""
    spans = []
    current_pid = token_mapping[0]["best_pid"]
    current_tokens = []
    
    for item in token_mapping:
        if item["best_pid"] == current_pid:
            current_tokens.append(item["token"])
        else:
            spans.append({"pid": current_pid, "text": "".join(current_tokens)})
            current_pid = item["best_pid"]
            current_tokens = [item["token"]]
            
    if current_tokens:
        spans.append({"pid": current_pid, "text": "".join(current_tokens)})
        
    final_parts = []
    for span in spans:
        if span["text"].strip():
            if span["pid"] is not None:
                final_parts.append(f"{span['text']} [{span['pid']}]")
            else:
                final_parts.append(span["text"])
                
    return "".join(final_parts)

# ==========================================
# 5. LA BOUCLE SUR TON DATAFRAME
# ==========================================

def run_citation_pipeline(df, model, tokenizer):
    """
    Fonction principale à appeler avec ton DataFrame.
    """
    results = []
    
    for idx, row in df.iterrows():
        question = row['question']
        paragraphs_list = row['contexts'] 
        
        # 1. Formatage
        system_prompt, user_prompt = format_prompt_fn(question, paragraphs_list)
        
        # 2. Génération et capture de l'attention
        generated_answer, token_attentions, prompt_input_ids, generated_ids = generate_with_attention(
            model, tokenizer, system_prompt, user_prompt
        )
        
        # 3. Positionnement spatial des paragraphes
        paragraph_spans = get_paragraph_token_spans(prompt_input_ids, paragraphs_list, tokenizer)
        
        # 4. Attribution selon l'Attributional Ensemble
        token_mapping = compute_attention_mapping_mechanistic(
            token_attentions, generated_ids, paragraph_spans, tokenizer
        )
        
        # 5. Construction de la réponse finale avec balises
        final_cited_answer = build_cited_answer(token_mapping)
        
        # On sauvegarde toutes les colonnes d'origine et on ajoute les nouvelles
        row_res = row.to_dict()
        row_res["generated_answer"] = generated_answer
        row_res["cited_answer"] = final_cited_answer
        
        results.append(row_res)
        
    return pd.DataFrame(results)
